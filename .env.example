# ═════════════════════════════════════════════════════════════════════════════
#  SmartWebCare — environment variables
#
#  Local:  copy this file to  .env.local  and fill in the values.
#  Vercel: Project → Settings → Environment Variables → add each one
#          (Production + Preview), then Deployments → ⋯ → Redeploy.
#          NEXT_PUBLIC_* values are baked in at build time, so a change only
#          shows on the live site after a redeploy.
#
#  Leave a value empty to use the default shown in the comment.
# ═════════════════════════════════════════════════════════════════════════════


# ── Website address ──────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap.xml, robots.txt and social share cards.
# Leave EMPTY on Vercel until your own domain is connected — the site then uses
# your Vercel production address automatically (e.g. https://smartwebcare.vercel.app).
# Set it to your domain only after the domain points at this Vercel project.
NEXT_PUBLIC_SITE_URL=


# ── Contact details (shown in header, footer, contact page, 404 page, legal) ─
# Phone shown on the site; "Call" buttons dial its digits. Default: +91 8065376767
NEXT_PUBLIC_CONTACT_PHONE=+91 8065376767
# Email shown on the site and used for "email us" links. Default: hello@socialguava.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@socialguava.com
# WhatsApp number — country code + number, digits only (e.g. 919876543210).
# When set, every WhatsApp button opens a chat with this number (with a ready
# message) and the number is shown in the footer / contact page.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# WhatsApp link used only when the number above is empty. Default: https://wa.link/0tfoce
NEXT_PUBLIC_WHATSAPP_URL=https://wa.link/0tfoce
# City / country shown in the footer and used in SEO data. Defaults: New Delhi / India
NEXT_PUBLIC_CONTACT_CITY=New Delhi
NEXT_PUBLIC_CONTACT_COUNTRY=India
# Optional full office address (replaces "City, Country" when set).
NEXT_PUBLIC_CONTACT_ADDRESS=
# Optional opening hours, e.g.  Mon–Sat, 10am–7pm IST
NEXT_PUBLIC_BUSINESS_HOURS=
# Booking calendar used on /book-consultation.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/grow-socialguava/30min
# Value of the free consultation, shown as "Worth $175 for FREE".
NEXT_PUBLIC_CONSULTATION_VALUE=175
# Business / legal name shown in legal pages and SEO data. Default: SmartWebCare
NEXT_PUBLIC_LEGAL_NAME=


# ── Social profiles (footer icons + SEO). Set to empty to hide one. ──────────
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/socialguava
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/socialguava/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/socialguava
NEXT_PUBLIC_X_URL=https://twitter.com/socialguava


# ── Supabase (enquiry form + Journal/blog) ───────────────────────────────────
# Supabase → Project Settings → API.  Run supabase/schema.sql once first.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon public" key — safe in the browser; it can only ADD enquiries and
# READ published blog posts (enforced by the RLS policies in schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key — SECRET. Server-only (no NEXT_PUBLIC_ prefix), never
# share it or put it in client code. Recommended for saving enquiries; if empty,
# the form saves with the anon key instead.
SUPABASE_SERVICE_ROLE_KEY=
# Table that stores form submissions. Default: enquiries
SUPABASE_ENQUIRIES_TABLE=enquiries


# ── Optional: get notified about every new enquiry ───────────────────────────
# Email alert through Resend (resend.com → API Keys). Without a verified domain
# Resend can only send to your own Resend account email.
RESEND_API_KEY=
# Who receives the alert (comma-separated). Default: the contact email above.
ENQUIRY_TO_EMAIL=
# Sender, e.g.  SmartWebCare <website@yourdomain.com>  (domain verified in Resend).
ENQUIRY_FROM_EMAIL=
# Any webhook (Zapier, Make, n8n, Slack, Google Sheets…) — receives the enquiry as JSON.
ENQUIRY_WEBHOOK_URL=


# ── Analytics — every tracker is OFF until its ID is set (production only) ───
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_DATAFAST_ID=
# NEXT_PUBLIC_MOUSEFLOW_ID=
# Set to "off" to disable all analytics regardless of the IDs above.
# NEXT_PUBLIC_ANALYTICS=off
